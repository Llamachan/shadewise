# Google AI Studio (Gemini), used through its OpenAI-compatible endpoint
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
CHAT_MODEL=gemini-2.5-flash
EMBED_MODEL=gemini-embedding-001

# Qdrant Cloud
QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=shadewise

# USD per 1M tokens. The free tier is free; put the paid rates here so the app can
# report what the same traffic would cost in production.
PRICE_IN_PER_1M=0
PRICE_OUT_PER_1M=0
PRICE_EMBED_PER_1M=0